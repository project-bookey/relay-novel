{
  "expo": {
    "name": "relay novel",
    "slug": "relay-novel",
    "scheme": "relay-novel",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.relaynovel.mobile"
    },
    "android": { "package": "app.relaynovel.mobile" },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "작품 표지로 쓸 사진을 고르려면 사진 보관함에 접근해야 해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": { "backgroundColor": "#2E3033" }
        }
      ]
    ],
    "extra": { "apiBaseUrl": "http://localhost:8080" }
  }
}
